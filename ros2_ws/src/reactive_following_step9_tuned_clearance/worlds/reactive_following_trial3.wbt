SimpleDiffRobot {
  translation 2.18 1.18 0.085
  rotation 0 0 1 -2.20
  name "R2"
  controller "udp_diff_driver"
  bodyColor 0.98 0.68 0.21
}
SimpleDiffRobot {
  translation -2.12 -1.26 0.085
  rotation 0 0 1 1.72
  name "R3"
  controller "udp_diff_driver"
  bodyColor 0.19 0.81 0.52
}
SimpleDiffRobot {
  translation 2.13 -2.05 0.085
  rotation 0 0 1 1.50
  name "R4"
  controller "udp_diff_driver"
  bodyColor 0.69 0.49 0.96
}
SimpleDiffRobot {
  translation -0.18 2.45 0.085
