#VRML_SIM R2023b utf8
EXTERNPROTO "../protos/SimpleDiffRobot.proto"

WorldInfo {
  title "Reactive Following — trial 3"
  basicTimeStep 32
  contactProperties [
    ContactProperties {
      material1 "body_support"
      material2 "floor"
      coulombFriction [ 0.05 ]
      bounce 0
    }
    ContactProperties {
      material1 "wheel_rubber"
      material2 "floor"
      coulombFriction [ 1.15 ]
      bounce 0
    }
    ContactProperties {
      material1 "body_support"
      material2 "default"
      coulombFriction [ 0.18 ]
      bounce 0
    }
    ContactProperties {
      material1 "wheel_rubber"
      material2 "default"
      coulombFriction [ 0.6 ]
      bounce 0
    }
    ContactProperties {
      material1 "body_support"
      material2 "body_support"
      coulombFriction [ 0.18 ]
      bounce 0
    }
    ContactProperties {
      material1 "wheel_rubber"
      material2 "body_support"
      coulombFriction [ 0.35 ]
      bounce 0
    }
    ContactProperties {
      material1 "wheel_rubber"
      material2 "wheel_rubber"
      coulombFriction [ 0.45 ]
      bounce 0
    }
  ]
  coordinateSystem "ENU"
}
Viewpoint {
  orientation 1 0 0 0.82
  position 0 -7.7 8.4
}
Background {
  skyColor [ 0.67 0.75 0.83 ]
}
DirectionalLight {
  direction 0.35 0.50 -1
  intensity 1.5
  ambientIntensity 0.4
}

# Flat 6 x 6 meter floor: top surface at z=0.
Solid {
  translation 0 0 -0.05
  name "floor"
  contactMaterial "floor"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.19 0.23 0.27
        roughness 1
        metalness 0
      }
      geometry DEF FLOOR_BOX Box { size 6 6 0.1 }
    }
  ]
  boundingObject USE FLOOR_BOX
}

# Perimeter walls: 0.24 m high, 0.12 m thick.
Solid {
  translation 0 2.94 0.12
  name "north_wall"
  children [
    DEF PERIMETER_WALL_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 0.60 0.65 0.70
        roughness 0.95
        metalness 0
      }
      geometry DEF WALL_NS Box { size 6 0.12 0.24 }
    }
  ]
  boundingObject USE WALL_NS
}
Solid {
  translation 0 -2.94 0.12
  name "south_wall"
  children [ USE PERIMETER_WALL_SHAPE ]
  boundingObject USE WALL_NS
}
Solid {
  translation 2.94 0 0.12
  name "east_wall"
  children [
    DEF WALL_EW_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 0.60 0.65 0.70
        roughness 0.95
      }
      geometry DEF WALL_EW Box { size 0.12 5.76 0.24 }
    }
  ]
  boundingObject USE WALL_EW
}
Solid {
  translation -2.94 0 0.12
  name "west_wall"
  children [ USE WALL_EW_SHAPE ]
  boundingObject USE WALL_EW
}

# Four short walls make following less predictable by causing occlusion
# and obstructing trajectories. Remove these for a clean baseline.
Solid {
  translation 0.1 0.65 0.095
  rotation 0 0 1 0.33
  name "inner_wall_A"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.77 0.47 0.27 roughness 0.9 }
      geometry DEF SHORT_WALL_A Box { size 1.25 0.12 0.19 }
    }
  ]
  boundingObject USE SHORT_WALL_A
}
Solid {
  translation -1.35 -0.56 0.095
  rotation 0 0 1 -0.75
  name "inner_wall_B"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.77 0.47 0.27 roughness 0.9 }
      geometry DEF SHORT_WALL_B Box { size 0.85 0.12 0.19 }
    }
  ]
  boundingObject USE SHORT_WALL_B
}
Solid {
  translation 1.55 -0.58 0.095
  rotation 0 0 1 0.52
  name "inner_wall_C"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.77 0.47 0.27 roughness 0.9 }
      geometry DEF SHORT_WALL_C Box { size 1.1 0.12 0.19 }
    }
  ]
  boundingObject USE SHORT_WALL_C
}
Solid {
  translation 0 -1.90 0.095
  name "inner_wall_D"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.77 0.47 0.27 roughness 0.9 }
      geometry DEF SHORT_WALL_D Box { size 0.80 0.12 0.19 }
    }
  ]
  boundingObject USE SHORT_WALL_D
}

# Five instances of the same PROTO with independent identity and pose.
# All five robots use separate instances of the same Webots UDP controller.
# Each controller talks to a dedicated ROS 2 bridge on ports 15001-15005.
# R1 keeps its original FOV overlay; the other cameras are active but
# their view outlines are hidden to reduce visual clutter.
SimpleDiffRobot {
  translation -1.80 2.10 0.085
  rotation 0 0 1 -0.60
  name "R1"
  controller "udp_diff_driver"
  bodyColor 0.10 0.72 0.95
