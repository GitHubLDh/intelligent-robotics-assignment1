#VRML_SIM R2023b utf8
EXTERNPROTO "../protos/SimpleDiffRobot.proto"
WorldInfo {
  title "Camera recognition — R1 sees R4 FRONT (should reject following)"
  basicTimeStep 32
  coordinateSystem "ENU"
}
Viewpoint {
  orientation 1 0 0 0.75
  position 0 -4.6 3.1
}
Background { skyColor [ 0.67 0.75 0.83 ] }
DirectionalLight { direction 0.35 0.50 -1 intensity 1.5 ambientIntensity 0.4 }
Solid {
  translation 0 0 -0.05
  name "floor"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.28 0.31 0.36 roughness 1 metalness 0 }
      geometry DEF FLOOR_SHAPE Box { size 6 6 0.1 }
    }
  ]
  boundingObject USE FLOOR_SHAPE
}
SimpleDiffRobot {
  translation -1 0 0.085
  rotation 0 0 1 0
  name "R1"
  controller "udp_diff_driver"
  bodyColor 0.10 0.72 0.95
}
SimpleDiffRobot {
  translation 1 0 0.085
  rotation 0 0 1 3.141592654
  name "R4"
  controller "udp_diff_driver"
  bodyColor 0.98 0.68 0.21
}
