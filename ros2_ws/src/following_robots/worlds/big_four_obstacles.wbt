#VRML_SIM R2023b utf8
EXTERNPROTO "../protos/SimpleDiffRobot.proto"

WorldInfo {
  title "Reactive Following - Big Arena with Four Obstacles"
  basicTimeStep 32
  contactProperties [
    ContactProperties {
      material1 "body_support"
      material2 "floor"
      coulombFriction [ 0.05 ]
      bounce 0
    }
    ContactProperties {
      material1 "wheel_rubber"
      material2 "floor"
      coulombFriction [ 1.15 ]
      bounce 0
    }
    ContactProperties {
      material1 "body_support"
      material2 "default"
      coulombFriction [ 0.18 ]
      bounce 0
    }
    ContactProperties {
      material1 "wheel_rubber"
      material2 "default"
      coulombFriction [ 0.6 ]
      bounce 0
    }
    ContactProperties {
      material1 "body_support"
      material2 "body_support"
      coulombFriction [ 0.18 ]
      bounce 0
    }
    ContactProperties {
      material1 "wheel_rubber"
      material2 "body_support"
      coulombFriction [ 0.35 ]
      bounce 0
    }
    ContactProperties {
      material1 "wheel_rubber"
      material2 "wheel_rubber"
      coulombFriction [ 0.45 ]
      bounce 0
    }
  ]
  coordinateSystem "ENU"
}

Viewpoint {
  orientation 1 0 0 0.82
  position 0 -14 15
}
Background {
  skyColor [ 0.67 0.75 0.83 ]
}
DirectionalLight {
  direction 0.35 0.50 -1
  intensity 1.5
  ambientIntensity 0.4
}

# Same 12 x 12 m arena as big_no_obstacles.wbt.
Solid {
  translation 0 0 -0.05
  name "floor"
  contactMaterial "floor"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.19 0.23 0.27
        roughness 1
        metalness 0
      }
      geometry DEF FLOOR_BOX Box { size 12 12 0.1 }
    }
  ]
  boundingObject USE FLOOR_BOX
}

Solid {
  translation 0 5.94 0.12
  name "north_wall"
  children [
    DEF PERIMETER_WALL_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 0.60 0.65 0.70
        roughness 0.95
        metalness 0
      }
      geometry DEF WALL_NS Box { size 12 0.12 0.24 }
    }
  ]
  boundingObject USE WALL_NS
}
Solid {
  translation 0 -5.94 0.12
  name "south_wall"
  children [ USE PERIMETER_WALL_SHAPE ]
  boundingObject USE WALL_NS
}
Solid {
  translation 5.94 0 0.12
  name "east_wall"
  children [
    DEF WALL_EW_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 0.60 0.65 0.70
        roughness 0.95
      }
      geometry DEF WALL_EW Box { size 0.12 11.76 0.24 }
    }
  ]
  boundingObject USE WALL_EW
}
Solid {
  translation -5.94 0 0.12
  name "west_wall"
  children [ USE WALL_EW_SHAPE ]
  boundingObject USE WALL_EW
}

# Four static obstacles. Their positions leave the initial robot formation clear.
Solid {
  translation -2.40 2.10 0.30
  name "obstacle_cylinder_northwest"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.86 0.34 0.12
        roughness 0.85
      }
      geometry DEF OBSTACLE_CYLINDER_NW Cylinder {
        radius 0.42
        height 0.60
        subdivision 32
      }
    }
  ]
  boundingObject USE OBSTACLE_CYLINDER_NW
}
Solid {
  translation 2.45 2.00 0.25
  rotation 0 0 1 0.35
  name "obstacle_box_northeast"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.15 0.62 0.42
        roughness 0.85
      }
      geometry DEF OBSTACLE_BOX_NE Box { size 1.10 0.75 0.50 }
    }
  ]
  boundingObject USE OBSTACLE_BOX_NE
}
Solid {
  translation 2.30 -2.20 0.22
  name "obstacle_cylinder_southeast"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.90 0.68 0.12
        roughness 0.85
      }
      geometry DEF OBSTACLE_CYLINDER_SE Cylinder {
        radius 0.34
        height 0.44
        subdivision 24
      }
    }
  ]
  boundingObject USE OBSTACLE_CYLINDER_SE
}
Solid {
  translation -2.45 -2.10 0.18
  rotation 0 0 1 -0.45
  name "obstacle_barrier_southwest"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.55 0.25 0.72
        roughness 0.85
      }
      geometry DEF OBSTACLE_BARRIER_SW Box { size 1.35 0.45 0.36 }
    }
  ]
  boundingObject USE OBSTACLE_BARRIER_SW
}

# Spread initial formation: four robots around the arena and one in the
# centre, leaving the four obstacles clear of the starting footprints.
SimpleDiffRobot {
  translation 0.0000 -4.2000 0.085
  rotation 0 0 1 1.5708
  name "R1"
  controller "udp_diff_driver"
  bodyColor 0.10 0.72 0.95
}
SimpleDiffRobot {
  translation -4.2000 0.0000 0.085
  rotation 0 0 1 0.0000
  name "R2"
  controller "udp_diff_driver"
  bodyColor 0.95 0.25 0.20
}
SimpleDiffRobot {
  translation 4.2000 0.0000 0.085
  rotation 0 0 1 3.1416
  name "R3"
  controller "udp_diff_driver"
  bodyColor 0.35 0.85 0.30
}
SimpleDiffRobot {
  translation 0.0000 4.2000 0.085
  rotation 0 0 1 4.7124
  name "R4"
  controller "udp_diff_driver"
  bodyColor 0.95 0.65 0.12
}
SimpleDiffRobot {
  translation 0.0000 0.0000 0.085
  rotation 0 0 1 1.5708
  name "R5"
  controller "udp_diff_driver"
  bodyColor 0.72 0.30 0.85
}
